---
---

<header class="site-header">
  <a class="monogram" href="#top" aria-label="Sergey Vorobev, home">SV</a>

  <div class="end">
    <nav aria-label="Sections">
      <a href="#projects">Projects</a>
      <a href="#about">About</a>
    </nav>

    <span class="divider" aria-hidden="true"></span>

    <div class="icons">
      <a class="icon-btn" href="https://github.com/sergeyvuser" aria-label="GitHub profile" title="GitHub profile">
        {/* GitHub mark, from Primer Octicons (MIT). */}
        <svg viewBox="0 0 16 16" width="18" height="18" aria-hidden="true" fill="currentColor">
          <path
            d="M8 0c4.42 0 8 3.58 8 8a8.013 8.013 0 0 1-5.45 7.59c-.4.08-.55-.17-.55-.38 0-.27.01-1.13.01-2.2 0-.75-.25-1.23-.54-1.48 1.78-.2 3.65-.88 3.65-3.95 0-.88-.31-1.59-.82-2.15.08-.2.36-1.02-.08-2.12 0 0-.67-.22-2.2.82-.64-.18-1.32-.27-2-.27-.68 0-1.36.09-2 .27-1.53-1.03-2.2-.82-2.2-.82-.44 1.1-.16 1.92-.08 2.12-.51.56-.82 1.28-.82 2.15 0 3.06 1.86 3.75 3.64 3.95-.23.2-.44.55-.51 1.07-.46.21-1.61.55-2.33-.66-.15-.24-.6-.83-1.23-.82-.67.01-.27.38.01.53.34.19.73.9.82 1.13.16.45.68 1.31 2.69.94 0 .67.01 1.3.01 1.49 0 .21-.15.45-.55.38A7.995 7.995 0 0 1 0 8c0-4.42 3.58-8 8-8Z"
          ></path>
        </svg>
      </a>

      {/*
        A toggle button: the label stays "Dark theme" and aria-pressed says whether it is on.
        Hidden until the script below runs, so without JavaScript there is no dead button
        and the page follows the system theme.
      */}
      <button class="icon-btn" type="button" aria-label="Dark theme" title="Dark theme" aria-pressed="false" data-theme-toggle hidden>
        {/* Moon and sun, after Feather icons (MIT). CSS shows the one for the theme you would switch to. */}
        <svg class="moon" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
        </svg>
        <svg class="sun" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="12" cy="12" r="5"></circle>
          <path d="M12 1v2M12 21v2M4.22 4.22l1.42 1.42M18.36 18.36l1.42 1.42M1 12h2M21 12h2M4.22 19.78l1.42-1.42M18.36 5.64l1.42-1.42"></path>
        </svg>
      </button>
    </div>
  </div>
</header>

<script>
  // The saved theme is already applied by the inline script in Base.astro; this wires up the button.
  const THEME_COLORS = { light: '#f6f9f7', dark: '#061a1c' } as const;
  type Theme = keyof typeof THEME_COLORS;

  const root = document.documentElement;
  const systemDark = window.matchMedia('(prefers-color-scheme: dark)');
  const button = document.querySelector<HTMLButtonElement>('[data-theme-toggle]');

  // An explicit choice wins; otherwise the theme is whatever the system says.
  function currentTheme(): Theme {
    const chosen = root.dataset.theme;
    if (chosen === 'light' || chosen === 'dark') return chosen;
    return systemDark.matches ? 'dark' : 'light';
  }

  function render() {
    button?.setAttribute('aria-pressed', String(currentTheme() === 'dark'));
  }

  function setTheme(theme: Theme) {
    root.dataset.theme = theme;
    for (const meta of document.querySelectorAll<HTMLMetaElement>('meta[name="theme-color"]')) {
      meta.content = THEME_COLORS[theme];
    }
    try {
      localStorage.setItem('theme', theme);
    } catch {
      // Storage blocked: the choice lasts until the page is reloaded.
    }
    render();
  }

  if (button) {
    button.hidden = false;
    render();
    button.addEventListener('click', () => setTheme(currentTheme() === 'dark' ? 'light' : 'dark'));
    // Keep the icon right when the system theme changes and nothing was chosen.
    systemDark.addEventListener('change', render);
  }
</script>

<style>
  .site-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 24px 0;
  }

  .monogram {
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    border-radius: 9px;
    background: var(--grad-fill);
    color: var(--on-grad);
    font-family: var(--font-mono);
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.02em;
    text-decoration: none;
  }

  .monogram:hover {
    color: var(--on-grad);
  }

  .end {
    display: flex;
    align-items: center;
    gap: 16px;
  }

  nav {
    display: flex;
    gap: 20px;
    font-size: 14px;
    color: var(--muted);
  }

  nav a {
    text-decoration: none;
    /* Not in the design: brings the tap target up to 24 px tall (WCAG 2.2 target size). */
    padding-block: 4px;
  }

  .divider {
    width: 1px;
    height: 20px;
    background: var(--line);
  }

  .icons {
    display: flex;
    align-items: center;
    gap: 4px;
  }

  /* Same 36 px square as the monogram; the icon takes the muted text colour. */
  .icon-btn {
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    padding: 0;
    border: 0;
    border-radius: 9px;
    background: none;
    color: var(--muted);
    cursor: pointer;
  }

  .icon-btn:hover {
    background: var(--chip);
    color: var(--ink);
  }

  /* The hidden attribute loses to display: grid above, so restate it. */
  .icon-btn[hidden] {
    display: none;
  }

  /* Light now: offer the moon. Dark now: offer the sun. */
  [aria-pressed='true'] .moon,
  [aria-pressed='false'] .sun {
    display: none;
  }
</style>
