---
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;

// Absolute URLs: link previews (Telegram, Slack) ignore relative ones.
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImageURL = new URL('/og.png', Astro.site);
const ogImageAlt = 'Sergey Vorobev, Python backend developer. Crypto Alerts: live demo, dashboard and source.';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />

    {/* Lets the browser pick its own light or dark UI (scrollbars, form controls) before CSS loads. */}
    <meta name="color-scheme" content="light dark" />
    {/* Colour of the browser's address bar on mobile, per theme: the page background. */}
    <meta name="theme-color" media="(prefers-color-scheme: light)" content="#f6f9f7" />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#061a1c" />

    {/*
      Applies a theme saved by the header toggle before the first paint, so the page does not
      flash the system theme first. is:inline keeps it a plain blocking script in the HTML;
      Astro would otherwise bundle it as a deferred module, which runs too late.
    */}
    <script is:inline>
      (() => {
        let saved = null;
        try {
          saved = localStorage.getItem('theme');
        } catch {
          // Storage can be blocked (privacy settings); the page then follows the system theme.
        }
        if (saved !== 'light' && saved !== 'dark') return;
        document.documentElement.dataset.theme = saved;
        const color = saved === 'dark' ? '#061a1c' : '#f6f9f7';
        for (const meta of document.querySelectorAll('meta[name="theme-color"]')) meta.content = color;
      })();
    </script>

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    {/* Open Graph: the card that LinkedIn, Telegram, Slack and others draw for a shared link. */}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="vorobev.dev" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogImageAlt} />

    {/* X (Twitter) reads og:* for the rest; it only needs the card type and the image alt here. */}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image:alt" content={ogImageAlt} />
  </head>
  <body>
    <slot />
  </body>
</html>
